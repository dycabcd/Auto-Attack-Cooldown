# ===========================
# Minecraft Mod — .gitignore
# 覆盖 Forge (1.20.1) 与 Fabric (1.21.11) 两个子模块
# ===========================

# --- 构建产物 ---
build/
**/build/
out/
bin/
classes/
generated/
*.jar
*.zip
*.tar.gz

# --- Gradle 缓存 ---
.gradle/
**/.gradle/
!gradle/wrapper/gradle-wrapper.jar

# --- ForgeGradle 缓存 ---
**/fg_cache/
**/META-INF/versions/

# --- Fabric Loom 缓存 ---
**/loom-cache/

# --- Mixin 调试输出 ---
*.mixin.out

# --- Minecraft 开发运行环境 ---
run/
**/run/
crash-reports/
**/crash-reports/
saves/
**/saves/

# --- IDE 生成文件 ---
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.factorypath
*.launch
nbproject/
*.ipr
*.iws

# --- 系统文件 ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.lnk
core.*

# --- 日志文件 ---
*.log
logs/
**/logs/

# --- 临时文件 ---
*.tmp
*.bak
*.swp
*.swo
*~
*.orig
*.rej

# --- 环境/本地配置 ---
local.properties
*.local

# --- WorkBuddy 工作区数据 ---
.workbuddy/
