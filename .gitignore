# =====================
# Minecraft Fabric 模组通用忽略规则
# =====================

# --- Gradle 构建缓存 & 输出 ---
.gradle/
autoattack-mod/.gradle/
autoattack-mod/build/
build/

# --- 预构建 JAR 文件（不提交构建产物） ---
*.jar
!autoattack-mod/gradle/wrapper/gradle-wrapper.jar

# --- Gradle Wrapper 二进制文件（保留 wrapper，忽略缓存） ---
# git 应追踪 gradlew、gradlew.bat、gradle/wrapper/*，但排除 gradle-wrapper.jar？实际上需要保留
# 下方保留了 wrapper jar

# --- IDE 配置 ---
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.vscode/
*.class

# --- Minecraft 运行目录 ---
run/

# --- 操作系统文件 ---
.DS_Store
Thumbs.db
Desktop.ini

# --- 日志 & 临时文件 ---
*.log
*.tmp
*.swp
*.swo
*~

# --- 编译器输出 ---
out/

# --- JAR 签名文件（如已签名） ---
META-INF/SIGNED.RSA
META-INF/SIGNED.SF

# --- 本地环境配置（不含敏感信息，但通常不共享） ---
local.properties

# --- AI 工作辅助工具配置 ---
.workbuddy/
